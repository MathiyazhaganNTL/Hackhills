# Bayora Environment Configuration Template
# (Do NOT commit real production credentials or secrets)

# Server Environment
PROJECT_NAME="Bayora AI Safety & Red-Teaming Infrastructure"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Cryptographic Keys & JWT
JWT_SECRET="bayora-production-security-secret-key-change-in-prod-32bytes"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Persistence (SQLite for local zero-dependency testing, PostgreSQL for multi-container production)
DATABASE_URL="sqlite+aiosqlite:///./bayora.db"
# DATABASE_URL="postgresql+asyncpg://bayora_user:your_password_here@localhost:5432/bayora_db"

# Container Isolation Governance
ENFORCE_CONTAINER_ISOLATION="false"
CGROUPS_VERSION="v2"
SECCOMP_PROFILE_PATH="/etc/bayora/seccomp/strict.json"

# Rate Limiting & Gateway Ceilings
MAX_REQUESTS_PER_MINUTE_DEFAULT=60
MAX_INPUT_TOKEN_LIMIT=4096

# Secrets Management (HashiCorp Vault)
VAULT_ADDR="http://127.0.0.1:8200"
VAULT_TOKEN=""

# Allowed CORS Origins
ALLOWED_ORIGINS='["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]'
